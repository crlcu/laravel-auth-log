{
    "name": "crlcu/laravel-auth-log",
    "description": "Login history, per-device sessions with real sign-out, new-device alerts and suspicious sign-in verification for Laravel.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Crlcu\\AuthLog\\": "src/",
            "Crlcu\\AuthLog\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Crlcu\\AuthLog\\AuthLogServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
